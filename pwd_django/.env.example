# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Django
SECRET_KEY=django-insecure-local-development-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (MySQL used in Docker; leave DB_ENGINE blank to use SQLite locally)
DB_ENGINE=django.db.backends.mysql
DB_NAME=pwd_django
DB_USER=pwd_user
DB_PASSWORD=strongpassword
DB_HOST=db
DB_PORT=3306

# MySQL root (only used by the db container)
MYSQL_ROOT_PASSWORD=rootstrongpassword
MYSQL_DATABASE=pwd_django
MYSQL_USER=pwd_user
MYSQL_PASSWORD=strongpassword

# Email
# ── Dev with MailHog (docker compose up mailhog) ────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PWD Access Kenya <noreply@pwdaccess.local>

# Local HTTP security behavior
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
TRUST_X_FORWARDED_PROTO=False
RUN_MIGRATIONS=True
COLLECT_STATIC=True
DB_WAIT_TIMEOUT=60

# Authentication and uploads
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
CERTIFICATE_VERIFY_MAX_ATTEMPTS=30
CERTIFICATE_VERIFY_WINDOW_SECONDS=60
MAX_DOCUMENT_UPLOAD_SIZE=10485760
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.png,.jpg,.jpeg
ALLOWED_DOCUMENT_CONTENT_TYPES=application/pdf,image/png,image/jpeg

# ── Production Gmail SMTP (replace values below) ────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_gmail@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password   # Gmail App Password
# DEFAULT_FROM_EMAIL=PWD Access Kenya <your_gmail@gmail.com>

# DocAssist — document Q&A for the PWD Assistant (leave the key blank to disable)
DOCASSIST_BASE_URL=http://38.242.200.57:8001/api/v1
DOCASSIST_API_KEY=
DOCASSIST_TIMEOUT_SECONDS=20

# Document Checker (scan quality / tamper screening in medical review)
DOC_CHECKER_BASE_URL=
DOC_CHECKER_API_KEY=
DOC_CHECKER_TIMEOUT_SECONDS=45
