# Copy to .env.production and replace every CHANGE_ME value before deployment.
# Never commit .env.production.

# Django
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DEBUG=False
ALLOWED_HOSTS=pwd.example.go.ke
CSRF_TRUSTED_ORIGINS=https://pwd.example.go.ke

# HTTPS and cookies
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=True
RUN_MIGRATIONS=False
COLLECT_STATIC=False
DB_WAIT_TIMEOUT=60

# Database
DB_ENGINE=django.db.backends.mysql
DB_NAME=pwd_django
DB_USER=pwd_user
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=pwd_django
MYSQL_USER=pwd_user
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.go.ke
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME_EMAIL_USERNAME
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=PWD Access Kenya <noreply@example.go.ke>

# Authentication and uploads
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
CERTIFICATE_VERIFY_MAX_ATTEMPTS=30
CERTIFICATE_VERIFY_WINDOW_SECONDS=60
MAX_DOCUMENT_UPLOAD_SIZE=10485760
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.png,.jpg,.jpeg
ALLOWED_DOCUMENT_CONTENT_TYPES=application/pdf,image/png,image/jpeg

# DocAssist — document Q&A for the PWD Assistant (leave the key blank to disable)
DOCASSIST_BASE_URL=http://38.242.200.57:8001/api/v1
DOCASSIST_API_KEY=
DOCASSIST_TIMEOUT_SECONDS=20

# Document Checker (scan quality / tamper screening in medical review)
DOC_CHECKER_BASE_URL=
DOC_CHECKER_API_KEY=
DOC_CHECKER_TIMEOUT_SECONDS=45
